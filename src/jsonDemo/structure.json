{
  "dynamicMethod": "data",
  "layout": "horizontallayout",
  "formType": "multiple",
  "formTitle": "center",
  "colGrid": "2",
  "gapCol": "40",
  "gapRow": "20",
  "dataFields": {
    "1": {
      "status": "Personal Info",
      "displayRemarks": "Please provide personal information",
      "displayField": [
        {
          "key": "senderMobileNumber",
          "label": "Sender Mobile Number",
          "placeholder": "Enter your mobile number",
          "fieldType": "text",
          "subType": "number",
          "errorColor": "#ff4d4f",
          "focusErrorBgColor": "#DCFFDB",
          "focusErrorBorderColor": "#008000",
          "placeHoldercolor": "#000",
          "readOnly": false,
          "validation": {
            "required": "Y",
            "validations": [
              {
                "regx": "^[6-9]\\d{9}$",
                "errorMessage": "Enter a valid 10-digit mobile number starting with 6-9."
              }
            ]
          }
        },
        {
          "key": "mobile",
          "label": "Beneficiary's Mobile No.",
          "placeholder": "Enter BeneFiciary Number",
          "fieldType": "text",
          "subType": "number",
          "errorColor": "#ff4d4f",
          "focusErrorBgColor": "#DCFFDB",
          "focusErrorBorderColor": "#008000",
          "placeHoldercolor": "#000",
          "validation": {
            "required": "N",
            "validations": [
              {
                "regex": "^[6-9]\\d{9}$",
                "errorMessage": "Enter a valid 10-digit mobile number starting with 6-9."
              }
            ]
          }
        },
        {
          "key": "panNumber",
          "label": "Pan Number",
          "placeholder": "Enter Pan Number",
          "fieldType": "text",
          "onlyFetchBtn": false,
          "ActionFetch": "Fetch Details",
          "validation": {
            "required": "Y",
            "errorMessage": "Pan number is mandatory.",
            "validations": [
              {
                "regex": "^[A-Z]{5}[0-9]{4}[A-Z]$",
                "errorMessage": "PAN Number does not match the correct format."
              },
              {
                "regex": "^[a-zA-Z0-9 ]*$",
                "errorMessage": "Non-alphanumeric characters not allowed."
              }
            ]
          }
        },
        {
          "key": "firstName",
          "label": "First Name",
          "placeholder": "Enter beneficiary first name",
          "fieldType": "text",
          "errorColor": "#ff4d4f",
          "focusErrorBgColor": "#DCFFDB",
          "focusErrorBorderColor": "#008000",
          "placeHoldercolor": "#000",
          "readOnly": true,
          "validation": {
            "required": "Y",
            "errorMessage": "First Name is required",
            "validations": [
              {
                "regex": "^(?!.*([a-zA-Z])\\1{3,})([A-Za-z]+(?: [A-Za-z]+)*)$",
                "errorMessage": "First Name should only contain letters and single spaces between words, and no letter should repeat more than 3 times consecutively"
              },
              {
                "regex": "^.{3,30}$",
                "errorMessage": "First Name must be between 3 and 30 characters"
              }
            ]
          }
        },
        {
          "key": "middleName",
          "label": "Middle Name",
          "placeholder": "Enter beneficiary middle name",
          "fieldType": "text",
          "errorColor": "#ff4d4f",
          "focusErrorBgColor": "#DCFFDB",
          "focusErrorBorderColor": "#008000",
          "placeHoldercolor": "#000",
          "readOnly": true
        },
        {
          "key": "lastName",
          "label": "Last Name",
          "placeholder": "Enter beneficiary last name",
          "fieldType": "text",
          "errorColor": "#ff4d4f",
          "focusErrorBgColor": "#DCFFDB",
          "focusErrorBorderColor": "#008000",
          "placeHoldercolor": "#000",
          "readOnly": true,
          "validation": {
            "required": "N",
            "validations": [
              {
                "regex": "^[A-Za-z]+(?: [A-Za-z]+)*$",
                "errorMessage": "Last Name should only contain letters and single spaces between words"
              },
              {
                "regex": "^.{3,}$",
                "errorMessage": "Last Name must be at least 3 characters"
              },
              {
                "regex": "^.{0,30}$",
                "errorMessage": "Last Name cannot exceed 30 characters"
              },
              {
                "regex": "^(?!.*\\s{2,}).*$",
                "errorMessage": "Last Name should not contain multiple consecutive spaces"
              },
              {
                "regex": "^(?!.*([a-zA-Z])\\1{3,}).*$",
                "errorMessage": "No letter should repeat more than 3 times consecutively"
              }
            ]
          }
        },
        {
          "key": "gender",
          "label": "Gender",
          "placeholder": "Select Gender",
          "fieldType": "dropdown",
          "dropdownOptions": [
            {
              "label": "Male",
              "value": "M"
            },
            {
              "label": "Female",
              "value": "F"
            },
            {
              "label": "Transgender",
              "value": "T"
            }
          ],
          "validation": {
            "required": "Y",
            "validations": [
              {
                "errorMessage": "Gender is required"
              }
            ]
          }
        },
        {
          "key": "dob",
          "label": "Date of Birth",
          "placeholder": "YYYY-MM-DD",
          "fieldType": "text",
          "subType": "date",
          "validation": {
            "required": "Y",
            "errorMessage": "Date of Birth is required",
            "validations": [
              {
                "type": "date",
                "max": "today",
                "errorMessage": "Date of Birth cannot be in the future"
              },
              {
                "type": "date",
                "min": "100-years-ago",
                "errorMessage": "Date of Birth cannot be more than 100 years ago"
              },
              {
                "type": "custom",
                "name": "is-adult",
                "errorMessage": "User must be at least 18 years old",
                "test": "value => { if (!value) return false; const today = new Date(); const minAllowedDate = new Date(today.getFullYear() - 18, today.getMonth(), today.getDate()); return value <= minAllowedDate; }"
              },
              {
                "type": "custom",
                "name": "not-today",
                "errorMessage": "Date of Birth cannot be today",
                "test": "value => { if (!value) return false; return value.toDateString() !== new Date().toDateString(); }"
              }
            ]
          }
        },
        {
          "key": "Upload Photo",
          "label": "Photo",
          "placeholder": "Upload Photo",
          "fieldType": "file",
          "nonInputLabel": "Choose Gender",
          "validation": {
            "required": "N",
            "validations": [
              {
                "errorMessage": "Please Upload Photo"
              }
            ]
          }
        }
      ]
    },
    "2": {
      "status": "Bank Info",
      "displayRemarks": "Please provide temporary address details",
      "displayField": [
        {
          "key": "bankName",
          "label": "Bank Name",
          "placeholder": "Enter Bank Name",
          "errorColor": "#ff4d4f",
          "fieldType": "SELECTCUS",
          "validation": {
            "required": "Y",
            "errorMessage": "Bank Name is required"
          }
        },
        {
          "key": "ifsc",
          "label": "Bank IFSC",
          "placeholder": "Enter IFSC",
          "fieldType": "text",
          "message": "Update Your IFSC Code As Per Your Branch",
          "validation": {
            "required": "N",
            "errorMessage": "Please select a valid relationship.",
            "validations": [
              {
                "regex": "^[A-Za-z0-9]{11}$",
                "errorMessage": "IFSC Code must be 11 alphanumeric characters"
              },
              {
                "regex": "[0-9]",
                "errorMessage": "IFSC Code must contain at least one numeric character"
              }
            ]
          }
        },
        {
          "key": "accountNumber1",
          "label": "Account Number",
          "placeholder": "Enter Account Number",
          "fieldType": "password",
          "validation": {
            "required": "Y",
            "errorMessage": "Account Number is required",
            "validations": [
              {
                "regex": "^\\d{8,18}$",
                "errorMessage": "Account Number must be between 8 and 18 digits and contain only numbers"
              }
            ]
          }
        },
        {
          "key": "confirmAccountNumber",
          "label": "Confirm Account Number",
          "placeholder": "Enter Confirm Number",
          "fieldType": "text",
          "ActionFetch": "click to verify",
          "validation": {
            "required": "Y",
            "errorMessage": "Account numbers must match",
            "validations": [
              {
                "regex": "^\\d{8,18}$",
                "errorMessage": "Account Number must be between 8 and 18 digits without spaces"
              }
            ]
          }
        },
        {
          "key": "accountNameAsPerBank",
          "label": "Name as per Bank",
          "placeholder": "Enter Name as per Bank",
          "fieldType": "text",
          "validation": {
            "required": "Y",
            "errorMessage": "Please select a valid relationship."
          }
        },
        {
          "key": "accountType",
          "label": "Account Type",
          "placeholder": "Select Account Type",
          "fieldType": "dropdown",
          "dropdownOptions": [
            {
              "label": "Saving",
              "value": "saving"
            },
            {
              "label": "Current",
              "value": "current"
            }
          ],
          "validation": {
            "required": "Y",
            "validations": [
              {
                "errorMessage": "Account Type is required"
              }
            ]
          }
        }
      ]
    },
    "3": {
      "status": "Address Information",
      "displayRemarks": "KYC Address",
      "displayField": [
        {
          "key": "permanentAddressLine1",
          "label": "Permanent Address Line 1",
          "placeholder": "Address Line 1",
          "fieldType": "text"
        },
        {
          "key": "permanentAddressLine2",
          "label": "Permanent Address Line 2",
          "placeholder": "Address Line 2",
          "fieldType": "text"
        },
        {
          "key": "pinCode",
          "label": "Permanent Pin Code",
          "placeholder": "Enter Pin Code",
          "fieldType": "text"
        },
        {
          "key": "permanentCity",
          "label": "Permanent City",
          "placeholder": "City",
          "fieldType": "text"
        },
        {
          "key": "permanentDistrict",
          "label": "Permanent District",
          "placeholder": "District",
          "fieldType": "dropdown",
          "dropdownOptions": [
            {
              "label": "Morang",
              "value": "morang",
              "default": true
            }
          ]
        },
        {
          "key": "permanentState",
          "label": "Permanent State",
          "placeholder": "State",
          "fieldType": "dropdown",
          "dropdownOptions": [
            {
              "label": "Province 1",
              "value": "province-1",
              "default": true
            }
          ]
        },
        {
          "key": "sameAsPermanent",
          "label": "Same as Permanent Address",
          "fieldType": "checkbox",
          "dropdownOptions": [
            {
              "label": "Same as Above",
              "value": "true"
            }
          ]
        },
        {},
        {
          "key": "tempAddressLine1",
          "label": "Temporary Address Line 1",
          "placeholder": "Address Line 1",
          "fieldType": "text"
        },
        {
          "key": "tempAddressLine2",
          "label": "Temporary Address Line 2",
          "placeholder": "Address Line 2",
          "fieldType": "text"
        },
        {
          "key": "tempPinCode",
          "label": "Temporary Pin Code",
          "placeholder": "Enter Pin Code",
          "fieldType": "text"
        },
        {
          "key": "tempCity",
          "label": "Temporary City",
          "placeholder": "City",
          "fieldType": "text"
        },
        {
          "key": "tempDistrict",
          "label": "Temporary District",
          "placeholder": "District",
          "fieldType": "dropdown",
          "dropdownOptions": [
            {
              "label": "Morang",
              "value": "morang",
              "default": true
            }
          ]
        },
        {
          "key": "tempState",
          "label": "Temporary State",
          "placeholder": "State",
          "fieldType": "dropdown",
          "dropdownOptions": [
            {
              "label": "Province 1",
              "value": "province-1",
              "default": true
            }
          ]
        }
      ]
    }
  }
}