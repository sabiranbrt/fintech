{
  "services": [
    {
      "label": "Credit Card Bill Payment",
      "key": "creditCardBill",
      "alias": "CC",
      "type": "payout",
      "uploadSlip": true,
      "subserviceStatus": "Y",
      "sequence": [
        "getSender",
        "getbankList",
        "getSlabDetails",
        "getChargeDetails",
        "initPayout"
      ]
    },
    {
      "label": "Fund Withdrawal",
      "key": "fundWithdrawal",
      "alias": "FW",
      "type": "payout",
      "paymentMethods": [
        {
          "value": "IMPS",
          "label": "IMPS"
        },
        {
          "value": "NEFT",
          "label": "NEFT"
        }
      ],
      "uploadSlip": true,
      "subserviceStatus": "Y",
      "sequence": [
        "getAgent",
        "getbankList",
        "getSlabDetails",
        "getChargeDetails",
        "initPayout",
        "uploadSlip"
      ]
    },
    {
      "label": "Rent Payment",
      "key": "rentPayment",
      "alias": "RP",
      "type": "payout",
      "uploadSlip": true,
      "subserviceStatus": "N",
      "paymentMethods": [
        {
          "value": "Ik Credit Pay",
          "label": "Rent Payment"
        }
      ],
      "sequence": [
        "getSender",
        "getbankList",
        "getSlabDetails",
        "getChargeDetails",
        "initPayout",
        "uploadSlip"
      ]
    },
    {
      "label": "Education Fees",
      "key": "educationFees",
      "type": "pgPayout",
      "alias": "EF",
      "uploadSlip": true,
      "subserviceStatus": "Y",
      "paymentMethods": [
        {
          "value": "Ik Credit Pay",
          "label": "Education Fees"
        }
      ],
      "sequence": [
        "getSender",
        "getbankList",
        "getSlabDetails",
        "getChargeDetails",
        "uploadSlip",
        "initPgPayout",
        "initVerify"
      ]
    },
    {
      "label": "Fund Settlement",
      "key": "fundSettlement",
      "type": "payout",
      "alias": "FS",
      "uploadSlip": false,
      "subserviceStatus": "Y",
      "paymentMethods": [
        {
          "value": "IMPS",
          "label": "IMPS"
        },
        {
          "value": "NEFT",
          "label": "NEFT"
        }
      ],
      "sequence": [
        "getSender",
        "getbankList",
        "getSlabDetails",
        "getChargeDetails",
        "initPayout"
      ]
    }
  ],
  "endPoints": {
    "initPgPayout": {
      "method": "POST",
      "enc": true,
      "url": "/api/v1/transaction"
    },
    "initVerify": {
      "method": "POST",
      "enc": true,
      "url": "/api/v1/transaction/verify"
    },
    "initPayout": {
      "method": "POST",
      "enc": true,
      "url": "/api/v1/transaction/payout"
    },
    "uploadSlip": {
      "method": "POST",
      "enc": true,
      "url": "/api/v1/upload/slip"
    },
    "getChargeDetails": {
      "method": "GET",
      "url": "/api/v1/transaction/charge-detail"
    },
    "getAgent": {
      "method": "GET",
      "url": "/api/v1/agent"
    },
    "getSlabDetails": {
      "method": "GET",
      "enc": false,
      "url": "/api/v1/slab",
      "headers": {
        "urn": "{{urn}}"
      }
    },
    "getSender": {
      "method": "POST",
      "enc": true,
      "queryParams": [
        "mobileNumber"
      ],
      "url": "/api/v1/sender/get"
    },
    "getCount": {
      "method": "GET",
      "url": "/api/v1/transaction/count"
    },
    "getbankList": {
      "method": "GET",
      "url": "/api/v1/bank"
    }
  }
}