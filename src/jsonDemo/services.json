{
  "services": [
    {
      "label": "Credit Card Bill Payment",
      "key": "creditCardBill",
      "alias": "CC",
      "type": "payout",
      "uploadSlip": true,
      "subserviceStatus": "Y",
      "sequence": [
        "getSender",
        "getbankList",
        "getSlabDetails",
        "getChargeDetails",
        "initPayout"
      ]
    },
    {
      "label": "Fund Withdrawal",
      "key": "fundWithdrawal",
      "alias": "FW",
      "type": "payout",
      "paymentMethods": [
        {
          "value": "IMPS",
          "label": "IMPS"
        },
        {
          "value": "NEFT",
          "label": "NEFT"
        }
      ],
      "uploadSlip": true,
      "subserviceStatus": "Y",
      "sequence": [
        "getAgent",
        "getbankList",
        "getSlabDetails",
        "getChargeDetails",
        "initPayout",
        "uploadSlip",
        "getPennyDrop",
        "getAgentAccount"
      ]
    },
    {
      "label": "Rent Payment",
      "key": "rentPayment",
      "alias": "RP",
      "type": "payout",
      "uploadSlip": true,
      "subserviceStatus": "N",
      "paymentMethods": [
        {
          "value": "Ik Credit Pay",
          "label": "Rent Payment"
        }
      ],
      "sequence": [
        "getSender",
        "getbankList",
        "getSlabDetails",
        "getChargeDetails",
        "uploadSlip",
        "initPgPayout",
        "initVerify"
      ]
    },
    {
      "label": "Education Fees",
      "key": "educationFees",
      "type": "pgPayout",
      "alias": "EF",
      "uploadSlip": true,
      "subserviceStatus": "Y",
      "paymentMethods": [
        {
          "value": "Ik Credit Pay",
          "label": "Education Fees"
        }
      ],
      "sequence": [
        "getSender",
        "getbankList",
        "getSlabDetails",
        "getChargeDetails",
        "uploadSlip",
        "initPgPayout",
        "initVerify",
        "getPennyDrop"
      ]
    },
    {
      "label": "Fund Settlement",
      "key": "fundSettlement",
      "type": "payout",
      "alias": "FS",
      "uploadSlip": false,
      "subserviceStatus": "Y",
      "paymentMethods": [
        {
          "value": "IMPS",
          "label": "IMPS"
        },
        {
          "value": "NEFT",
          "label": "NEFT"
        }
      ],
      "sequence": [
        "getSender",
        "getbankList",
        "getSlabDetails",
        "getChargeDetails",
        "initPayout",
        "getPennyDrop"
      ]
    },
    {
      "label": "Register Sender",
      "key": "registerSender",
      "type": "payout",
      "alias": "RS",
      "uploadSlip": false,
      "subserviceStatus": "Y",
      "paymentMethods": [
        {
          "value": "IMPS",
          "label": "IMPS"
        },
        {
          "value": "NEFT",
          "label": "NEFT"
        }
      ],
      "sequence": [
        "getSender",
        "getbankList",
        "getSlabDetails",
        "getChargeDetails",
        "initPayout"
      ]
    },
    {
      "label": "Transactions",
      "key": "transactions",
      "type": "payout",
      "alias": "T",
      "uploadSlip": false,
      "subserviceStatus": "Y",
      "sequence": [
        "recentTransaction",
        "initPgPayout",
        "receiptTransaction"
      ]
    },
    {
      "label": "Total Payout",
      "key": "totalPayout",
      "type": "payout",
      "alias": "TP",
      "uploadSlip": false,
      "subserviceStatus": "Y",
      "sequence": [
        "getSender",
        "getbankList",
        "getSlabDetails",
        "getChargeDetails",
        "initPayout",
        "getCount"
      ]
    },
    {
      "label": "Load Wallet",
      "key": "loadWallet",
      "type": "payout",
      "alias": "LW",
      "uploadSlip": false,
      "subserviceStatus": "Y",
      "sequence": [
        "getAgent",
        "getbankList",
        "getSlabDetails",
        "getChargeDetails",
        "initPayout"
      ]
    },
    {
      "label": "Account Ledger",
      "key": "accountLedger",
      "type": "payout",
      "alias": "AL",
      "uploadSlip": false,
      "subserviceStatus": "Y",
      "sequence": [
        "getSender",
        "getbankList",
        "getSlabDetails",
        "getChargeDetails",
        "initPayout",
        "getLedger"
      ]
    },
    {
      "label": "Relationship Manager",
      "key": "relationshipManager",
      "type": "payout",
      "alias": "RM",
      "uploadSlip": false,
      "subserviceStatus": "Y",
      "sequence": [
        "getSender",
        "getbankList",
        "getSlabDetails",
        "getChargeDetails",
        "initPayout",
        "getContact"
      ]
    }
  ],
  "endPoints": {
    "initPgPayout": {
      "method": "GET",
      "enc": true,
      "url": "/api/v1/transaction"
    },
    "recentTransaction": {
      "method": "GET",
      "enc": true,
      "url": "/api/v1/transaction/recent"
    },
    "receiptTransaction": {
      "method": "GET",
      "enc": true,
      "url": "/api/v1/transaction/html-receipt/"
    },
    "initVerify": {
      "method": "POST",
      "enc": true,
      "url": "/api/v1/transaction/verify"
    },
    "initPayout": {
      "method": "POST",
      "enc": true,
      "url": "/api/v1/transaction/payout"
    },
    "uploadSlip": {
      "method": "POST",
      "enc": true,
      "url": "/api/v1/upload/slip"
    },
    "getChargeDetails": {
      "method": "GET",
      "url": "/api/v1/transaction/charge-detail"
    },
    "getPennyDrop": {
      "method": "POST",
      "enc": true,
      "url": "/api/v1/penny-drop"
    },
    "getAgent": {
      "method": "GET",
      "url": "/api/v1/agent"
    },
    "getAgentAccount": {
      "method": "POST",
      "url": "/api/v1/agent/account"
    },
    "getSlabDetails": {
      "method": "GET",
      "enc": false,
      "url": "/api/v1/slab",
      "headers": {
        "urn": "{{urn}}"
      }
    },
    "getSender": {
      "method": "POST",
      "enc": true,
      "queryParams": [
        "mobileNumber"
      ],
      "url": "/api/v1/sender/get"
    },
    "getCount": {
      "method": "GET",
      "url": "/api/v1/transaction/count"
    },
    "getbankList": {
      "method": "GET",
      "url": "/api/v1/bank"
    },
    "getContact": {
      "method": "GET",
      "url": "/api/v1/agent/relationship-manager/get"
    },
    "getLedger": {
      "method": "POST",
      "url": "/api/v1/accounts/get-ledger"
    }
  }
}